[Unit]
Description=AI Parking Client Backend (FastAPI/Uvicorn)
After=network.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__INSTALL_DIR__
Environment="PATH=__INSTALL_DIR__/.venv/bin:/usr/bin:/bin"
ExecStart=__UV__ run uvicorn app.main:app --reload
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
